== 1. expansion ==
let var"##interpolated#144" = x
    (UnitTestDesign._macro_rule)(:forbid, (:a, :b), ((var"##a#142", var"##b#143")->var"##a#142" == 1 && var"##b#143" > var"##interpolated#144"), "@forbid(a == 1 && b > \$x)", "why")
end

== 2. macro from a module that only imports the package ==
scope=(:a, :b) label=@forbid(helper(a) && b == 2) source=macro
forbidden=Set([(2, 2)])

== 3. macro vs listed-names Constraint fields ==
scope      macro=(:a,)   names=(:a,)
predicate  macro=var"#2#3"()   names=var"#5#6"()
polarity   macro=:forbid   names=:forbid
label      macro="@forbid(a == 1)"   names=""
source     macro=:macro   names=:names
pattern    macro=nothing   names=nothing

